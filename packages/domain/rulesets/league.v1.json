{
  "version": 1,
  "rounding": 2,
  "name": "League rules (received 2026-11-10; ambiguities assumed, see doc 04 section 2)",
  "rules": [
    {
      "stat": "pass_yds",
      "points": 1,
      "per": 30,
      "positions": ["QB"],
      "label": "Passing yards (1 per 30)"
    },
    { "stat": "pass_td", "points": 6, "label": "Passing TD" },
    { "stat": "pass_int", "points": -1, "label": "Interception thrown" },
    { "stat": "rush_yds", "points": 1, "per": 10, "label": "Rushing yards (1 per 10)" },
    { "stat": "rush_td", "points": 6, "label": "Rushing TD" },
    { "stat": "rec_yds", "points": 1, "per": 10, "label": "Receiving yards (1 per 10)" },
    { "stat": "rec_td", "points": 6, "label": "Receiving TD" },
    { "stat": "ret_td", "points": 6, "label": "Kick/punt return TD" },
    { "stat": "fum_rec_td", "points": 6, "label": "Fumble recovery TD" },
    { "stat": "fum_lost", "points": -1, "label": "Fumble lost" },
    { "stat": "xp_made", "points": 1, "positions": ["K"], "label": "Extra point" },
    {
      "stat": "fg_made",
      "type": "distance_tiers",
      "positions": ["K"],
      "label": "Field goal",
      "tiers": [
        { "min": 0, "max": 39, "points": 3 },
        { "min": 40, "max": 49, "points": 4 },
        { "min": 50, "points": 5 }
      ]
    },
    {
      "stat": "def_pts_allowed",
      "type": "tiers",
      "positions": ["DST"],
      "label": "Points allowed",
      "tiers": [
        { "min": 0, "max": 0, "points": 15 },
        { "min": 1, "max": 6, "points": 10 },
        { "min": 7, "max": 13, "points": 8 },
        { "min": 14, "max": 20, "points": 5 },
        { "min": 21, "max": 27, "points": 2 },
        { "min": 28, "max": 34, "points": 0 },
        { "min": 35, "points": -5 }
      ]
    },
    { "stat": "def_sack", "points": 1, "positions": ["DST"], "label": "Sack" },
    { "stat": "def_int", "points": 1, "positions": ["DST"], "label": "Interception" },
    { "stat": "def_fum_rec", "points": 1, "positions": ["DST"], "label": "Fumble recovery" },
    { "stat": "def_block", "points": 1, "positions": ["DST"], "label": "Blocked kick" },
    { "stat": "def_safety", "points": 2, "positions": ["DST"], "label": "Safety" },
    { "stat": "def_td", "points": 6, "positions": ["DST"], "label": "Defensive TD" }
  ]
}
