{
  "name": "draft-and-pray",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n ddb,api,web -c yellow,blue,green \"pnpm ddb:local\" \"pnpm --filter @dnp/api dev\" \"pnpm --filter @dnp/web dev\"",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ddb:local": "node scripts/dynamodb-local.mjs",
    "admin": "tsx scripts/admin/index.ts",
    "smoke": "tsx scripts/smoke/index.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@dnp/contract": "workspace:*",
    "@dnp/db": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "@smithy/types": "^4.20.0"
    }
  }
}
